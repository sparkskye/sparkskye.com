{"asset":{"version":"2.0","generator":"Blockbench 5.2.2 glTF exporter"},"scenes":[{"nodes":[1],"name":"blockbench_export"}],"scene":0,"nodes":[{"translation":[0.5625,-1.5,-0.1875],"name":"cape","extras":{"saOriginalCastShadow":false,"saOriginalReceiveShadow":false,"saCollapsedMaterialSlots":false,"saOriginalMaterialSlotCount":1,"saPerDrawUniformSync":true,"saAppliedShaderArchitectMaterial":{"sa_format_version":"2.0","id":"classic","name":"Classic Shader","icon":"lightflow:classic","isCustom":false,"enableShadows":false,"supportsScreenSpaceReflections":false,"screenAccess":"none","vertex":"\n                     //Classic\n                    attribute float highlight;\n                    attribute float autoTile;\n                    attribute vec4 autoTileBasis;\n                    attribute vec2 normalizedFaceUv;\n                    attribute vec2 globalFaceSize;\n                    attribute vec2 uvSize;\n\n                     uniform bool SHADE;\n                     uniform int LIGHTSIDE;\n\n                     varying vec2 vUv;\n                    varying vec2 vNormalizedFaceUv;\n                    varying vec2 vFaceSize;\n                    varying vec2 vUvSize;\n                    varying float vAutoTile;\n                    varying vec4 vAutoTileBasis;\n                     varying float light;\n                     varying float lift;\n\n                    void main() {\n                        if (SHADE) {\n                            // Use normalMatrix for correct orientation with scaling.\n                            vec3 N = normalize(normalMatrix * normal);\n\n                            if (LIGHTSIDE == 1) { float t = N.y; N.y = -N.z; N.z = t; }\n                            else if (LIGHTSIDE == 2) { float t = N.y; N.y = N.x; N.x = t; }\n                            else if (LIGHTSIDE == 3) { N.y = -N.y; }\n                            else if (LIGHTSIDE == 4) { float t = N.y; N.y = N.z; N.z = t; }\n                            else if (LIGHTSIDE == 5) { float t = N.y; N.y = -N.x; N.x = t; }\n\n                            float yLight = (1.0 + N.y) * 0.5;\n                            light = yLight * 0.5 + N.x * N.x * -0.15 + N.z * N.z * 0.05 + 0.5;\n                        } else {\n                            light = 1.0;\n                        }\n\n                         lift = (highlight == 2.0) ? 0.22 : (highlight == 1.0) ? 0.1 : 0.0;\n                         vUv = uv;\n                        vNormalizedFaceUv = normalizedFaceUv;\n                        vFaceSize = globalFaceSize;\n                        vUvSize = uvSize;\n                        vAutoTile = autoTile;\n                        vAutoTileBasis = autoTileBasis;\n\n                         gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);\n                     }\n                 ","fragment":"\n                    \n#ifndef LIGHTFLOW_TEXTURE_TILING_MODULE\n#define LIGHTFLOW_TEXTURE_TILING_MODULE\n\nuniform bool AUTO_TILE;\nuniform vec2 TILING;\nuniform vec2 TEXTURE_SIZE;\n\nvec2 lfResolveTextureTiling(\n    vec2 faceSize,\n    vec2 uvSize,\n    float geometryAutoTile\n) {\n    if (geometryAutoTile > 0.5 || AUTO_TILE) {\n        vec2 safeFaceSize = max(abs(faceSize), vec2(0.000001));\n        vec2 tileSize = max(abs(uvSize * faceSize), vec2(0.000001));\n        return safeFaceSize / tileSize;\n    }\n\n    return TILING;\n}\n\n// Backward-compatible overload for custom shaders that still use the uniform.\nvec2 lfResolveTextureTiling(vec2 faceSize, vec2 uvSize) {\n    return lfResolveTextureTiling(faceSize, uvSize, AUTO_TILE ? 1.0 : 0.0);\n}\n\n#ifndef LIGHTFLOW_TEXTURE_TILING_VERTEX_STAGE\nbool lfResolveTextureDerivativeBasis(\n    vec2 derivativeDx,\n    vec2 derivativeDy,\n    out vec2 normalizedDx,\n    out vec2 normalizedDy,\n    out float derivativeScale,\n    out float inverseDeterminant\n) {\n    derivativeScale = max(\n        max(abs(derivativeDx.x), abs(derivativeDx.y)),\n        max(abs(derivativeDy.x), abs(derivativeDy.y))\n    );\n    normalizedDx = vec2(0.0);\n    normalizedDy = vec2(0.0);\n    inverseDeterminant = 0.0;\n\n    if (derivativeScale <= 1e-12) return false;\n\n    normalizedDx = derivativeDx / derivativeScale;\n    normalizedDy = derivativeDy / derivativeScale;\n\n    float determinant = normalizedDx.x * normalizedDy.y -\n        normalizedDx.y * normalizedDy.x;\n    float basisArea = length(normalizedDx) * length(normalizedDy);\n    float basisQuality = abs(determinant) / max(basisArea, 1e-12);\n\n    if (abs(determinant) <= 1e-12 || basisQuality <= 1e-5) return false;\n\n    inverseDeterminant = 1.0 / determinant;\n    return true;\n}\n\nmat2 lfGetLocalToAtlasJacobian(vec2 localUv, vec2 atlasUv, out bool valid) {\n    vec2 localDx = dFdx(localUv);\n    vec2 localDy = dFdy(localUv);\n    vec2 atlasDx = dFdx(atlasUv);\n    vec2 atlasDy = dFdy(atlasUv);\n    vec2 normalizedLocalDx;\n    vec2 normalizedLocalDy;\n    float derivativeScale;\n    float inverseDeterminant;\n\n    valid = lfResolveTextureDerivativeBasis(\n        localDx,\n        localDy,\n        normalizedLocalDx,\n        normalizedLocalDy,\n        derivativeScale,\n        inverseDeterminant\n    );\n\n    if (!valid) return mat2(0.0);\n\n    vec2 normalizedAtlasDx = atlasDx / derivativeScale;\n    vec2 normalizedAtlasDy = atlasDy / derivativeScale;\n    vec2 atlasPerLocalX = (\n        normalizedAtlasDx * normalizedLocalDy.y -\n        normalizedAtlasDy * normalizedLocalDx.y\n    ) * inverseDeterminant;\n    vec2 atlasPerLocalY = (\n        normalizedAtlasDy * normalizedLocalDx.x -\n        normalizedAtlasDx * normalizedLocalDy.x\n    ) * inverseDeterminant;\n\n    return mat2(atlasPerLocalX, atlasPerLocalY);\n}\n\nvec2 lfResolveMaterialUvWithJacobian(\n    vec2 atlasUv,\n    vec2 localUv,\n    mat2 localToAtlas,\n    vec2 faceSize,\n    vec2 uvSize,\n    float geometryAutoTile\n) {\n    vec2 repeatCount = lfResolveTextureTiling(faceSize, uvSize, geometryAutoTile);\n    vec2 tiledLocalUv = localUv;\n\n    if (abs(repeatCount.x - 1.0) > 0.000001) {\n        tiledLocalUv.x = fract(localUv.x * repeatCount.x);\n    }\n    if (abs(repeatCount.y - 1.0) > 0.000001) {\n        tiledLocalUv.y = fract(localUv.y * repeatCount.y);\n    }\n\n    return atlasUv + localToAtlas * (tiledLocalUv - localUv);\n}\n\nbool lfResolveExplicitAutoTileBasis(\n    vec4 packedBasis,\n    out mat2 localToAtlas\n) {\n    localToAtlas = mat2(packedBasis.xy, packedBasis.zw);\n    float determinant = packedBasis.x * packedBasis.w -\n        packedBasis.z * packedBasis.y;\n    float basisScale = max(\n        max(abs(packedBasis.x), abs(packedBasis.y)),\n        max(abs(packedBasis.z), abs(packedBasis.w))\n    );\n    return basisScale > 1e-12 && abs(determinant) > 1e-12;\n}\n\nbool lfResolveUv(\n    vec2 localUv,\n    vec2 atlasUv,\n    vec4 explicitAutoTileBasis,\n    out mat2 localToAtlas\n) {\n    if (lfResolveExplicitAutoTileBasis(explicitAutoTileBasis, localToAtlas)) {\n        return true;\n    }\n    bool validJacobian = false;\n    localToAtlas = lfGetLocalToAtlasJacobian(localUv, atlasUv, validJacobian);\n    return validJacobian;\n}\n\nvec2 lfResolveMaterialUv(\n    vec2 atlasUv,\n    vec2 localUv,\n    vec2 faceSize,\n    vec2 uvSize,\n    float geometryAutoTile,\n    vec4 explicitAutoTileBasis\n) {\n    mat2 localToAtlas;\n    if (!lfResolveUv(\n        localUv,\n        atlasUv,\n        explicitAutoTileBasis,\n        localToAtlas\n    )) return atlasUv;\n    return lfResolveMaterialUvWithJacobian(\n        atlasUv,\n        localUv,\n        localToAtlas,\n        faceSize,\n        uvSize,\n        geometryAutoTile\n    );\n}\n\nvec2 lfResolveMaterialUv(\n    vec2 atlasUv,\n    vec2 localUv,\n    vec2 faceSize,\n    vec2 uvSize,\n    float geometryAutoTile\n) {\n    return lfResolveMaterialUv(\n        atlasUv,\n        localUv,\n        faceSize,\n        uvSize,\n        geometryAutoTile,\n        vec4(0.0)\n    );\n}\n\nvec2 lfResolveMaterialUv(\n    vec2 atlasUv,\n    vec2 localUv,\n    vec2 faceSize,\n    vec2 uvSize\n) {\n    return lfResolveMaterialUv(\n        atlasUv,\n        localUv,\n        faceSize,\n        uvSize,\n        AUTO_TILE ? 1.0 : 0.0\n    );\n}\n#endif\n\n#endif\n\n\n                     uniform sampler2D map;\n                     uniform bool EMISSIVE;\n                     uniform vec3 LIGHTCOLOR;\n\n                     varying vec2 vUv;\n                    varying vec2 vNormalizedFaceUv;\n                    varying vec2 vFaceSize;\n                    varying vec2 vUvSize;\n                    varying float vAutoTile;\n                    varying vec4 vAutoTileBasis;\n                     varying float light;\n                     varying float lift;\n\n                     void main() {\n                        vec2 materialUv =\n                            lfResolveMaterialUv(\n                                vUv,\n                                vNormalizedFaceUv,\n                                vFaceSize,\n                                vUvSize,\n                                vAutoTile,\n                                vAutoTileBasis\n                            );\n                        vec4 color = texture2D(map, materialUv);\n                         if(color.a < 0.01) discard;\n\n                        if (!EMISSIVE) {\n                            gl_FragColor = vec4(lift + color.rgb * light, color.a);\n                            gl_FragColor.rgb *= LIGHTCOLOR;\n                        } else {\n                            vec3 light_mix = (light * LIGHTCOLOR) + (1.0 - light * LIGHTCOLOR) * (1.0 - color.a);\n                            gl_FragColor = vec4(lift + color.rgb * light_mix, 1.0);\n                        }\n\n                        if (lift > 0.2) {\n                            gl_FragColor.rg *= vec2(0.6, 0.7);\n                        }\n                    }\n                 ","uniforms":{"map":{"type":"sampler2D","repeat":true,"expose":true,"valu