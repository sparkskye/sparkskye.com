sphere":{"value":false},"uSAEnvironmentSky":{"type":"v3","value":[0.5251135684132552,0.6910475068498041,1]},"uSAEnvironmentGround":{"type":"v3","value":[0.7019607843137254,0.8196078431372549,0.9529411764705882]},"uSAEnvironmentEnabled":{"value":0},"uSAEnvironmentAmbient":{"type":"v3","value":[0.5795343137254901,0.7302696078431372,0.9926470588235294]},"uSAEnvironmentStrength":{"value":0}},"vertexShader":"\n// SA_LIGHTFLOW_INSTANCING_VERTEX\nvec3 saApplyInstancePosition(vec3 value) {\n#ifdef USE_INSTANCING\n    return (instanceMatrix * vec4(value, 1.0)).xyz;\n#else\n    return value;\n#endif\n}\n\nvec3 saApplyInstanceNormal(vec3 value) {\n#ifdef USE_INSTANCING\n    return mat3(instanceMatrix) * value;\n#else\n    return value;\n#endif\n}\n\n\nvarying vec3 lfAtmosphereViewPosition;\nvarying float lfAtmosphereWorldHeight;\nvarying vec3 lfAtmosphereWorldPosition;\n\n                     //Classic\n                    attribute float highlight;\n                    attribute float autoTile;\n                    attribute vec4 autoTileBasis;\n                    attribute vec2 normalizedFaceUv;\n                    attribute vec2 globalFaceSize;\n                    attribute vec2 uvSize;\n\n                     uniform bool SHADE;\n                     uniform int LIGHTSIDE;\n\n                     varying vec2 vUv;\n                    varying vec2 vNormalizedFaceUv;\n                    varying vec2 vFaceSize;\n                    varying vec2 vUvSize;\n                    varying float vAutoTile;\n                    varying vec4 vAutoTileBasis;\n                     varying float light;\n                     varying float lift;\n\n                    \n// SA_LIGHTFLOW_MRT_VERTEX\nvarying vec3 vSA_MRTViewNormal;\n\nvoid main() {\n    vSA_MRTViewNormal = normalize(normalMatrix * saApplyInstanceNormal(normal));\n                        if (SHADE) {\n                            // Use normalMatrix for correct orientation with scaling.\n                            vec3 N = normalize(normalMatrix * saApplyInstanceNormal(normal));\n\n                            if (LIGHTSIDE == 1) { float t = N.y; N.y = -N.z; N.z = t; }\n                            else if (LIGHTSIDE == 2) { float t = N.y; N.y = N.x; N.x = t; }\n                            else if (LIGHTSIDE == 3) { N.y = -N.y; }\n                            else if (LIGHTSIDE == 4) { float t = N.y; N.y = N.z; N.z = t; }\n                            else if (LIGHTSIDE == 5) { float t = N.y; N.y = -N.x; N.x = t; }\n\n                            float yLight = (1.0 + N.y) * 0.5;\n                            light = yLight * 0.5 + N.x * N.x * -0.15 + N.z * N.z * 0.05 + 0.5;\n                        } else {\n                            light = 1.0;\n                        }\n\n                         lift = (highlight == 2.0) ? 0.22 : (highlight == 1.0) ? 0.1 : 0.0;\n                         vUv = uv;\n                        vNormalizedFaceUv = normalizedFaceUv;\n                        vFaceSize = globalFaceSize;\n                        vUvSize = uvSize;\n                        vAutoTile = autoTile;\n                        vAutoTileBasis = autoTileBasis;\n\n                         gl_Position = projectionMatrix * modelViewMatrix * vec4(saApplyInstancePosition(position), 1.0);\n                     \n    vec4 lfFogLocalPosition = vec4(saApplyInstancePosition(position), 1.0);\n#ifdef USE_INSTANCING\n    lfFogLocalPosition = instanceMatrix * lfFogLocalPosition;\n#endif\n    lfAtmosphereViewPosition = (modelViewMatrix * lfFogLocalPosition).xyz;\n    lfAtmosphereWorldHeight = (modelMatrix * lfFogLocalPosition).y;\n    lfAtmosphereWorldPosition = (modelMatrix * lfFogLocalPosition).xyz;\n}\n                 ","fragmentShader":"\n// SA_LIGHTFLOW_MRT_FRAGMENT\n#define SA_LIGHTFLOW_MRT_ENABLED 1\n#define SA_LIGHTFLOW_MRT4_RIM_GLOW_ENABLED 1\n#define SA_LIGHTFLOW_MRT5_RIM_DEPTH_ENABLED 1\nvarying vec3 vSA_MRTViewNormal;\n#ifndef gl_FragColor\nlayout(location = 0) out highp vec4 pc_fragColor;\n#define gl_FragColor pc_fragColor\n#endif\nlayout(location = 1) out highp vec4 saMRTSurface;\nlayout(location = 2) out highp vec4 saMRTEmission;\nlayout(location = 3) out highp vec4 saMRTRimGlow;\n#if SA_LIGHTFLOW_MRT5_RIM_DEPTH_ENABLED == 1\nlayout(location = 4) out highp vec4 saMRTRimDepth;\n#endif\nuniform bool PROMO_RIM_ENABLED;\nuniform float PROMO_RIM_WIDTH;\n\n\nvarying vec3 lfAtmosphereViewPosition;\nvarying float lfAtmosphereWorldHeight;\nvarying vec3 lfAtmosphereWorldPosition;\nuniform vec3 lfAtmosphereFogColor;\nuniform vec3 lfAtmosphereFogNearColor;\nuniform vec4 lfAtmosphereFogParams;\nuniform vec4 lfAtmosphereHeightParams;\nuniform vec4 lfAtmosphereStyleParams;\nuniform vec4 lfAtmosphereArtParams;\nuniform vec4 lfAtmosphereSkyParams;\nuniform sampler2D lfAtmosphereSkyGradient;\nuniform vec4 lfAtmosphereFrameParams;\nuniform vec4 lfAtmosphereGradeParams;\nuniform vec4 lfAtmosphereGradeLook;\nuniform vec3 lfAtmosphereGradeTint;\nuniform float lfAtmosphereCameraHeight;\nfloat lfAtmosphereDistanceRamp(float distanceValue, float start, float end, float curve) {\n    float t = clamp((distanceValue - start) / max(end - start, 0.0001), 0.0, 1.0);\n    return pow(t, curve);\n}\nfloat lfAtmosphereNoiseHash(vec3 p) {\n    p = fract(p * 0.1031);\n    p += dot(p, p.yzx + 33.33);\n    return fract((p.x + p.y) * p.z);\n}\nfloat lfAtmosphereNoise(vec3 p) {\n    vec3 cell = floor(p), f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(mix(lfAtmosphereNoiseHash(cell), lfAtmosphereNoiseHash(cell + vec3(1,0,0)), f.x),\n                   mix(lfAtmosphereNoiseHash(cell + vec3(0,1,0)), lfAtmosphereNoiseHash(cell + vec3(1,1,0)), f.x), f.y),\n               mix(mix(lfAtmosphereNoiseHash(cell + vec3(0,0,1)), lfAtmosphereNoiseHash(cell + vec3(1,0,1)), f.x),\n                   mix(lfAtmosphereNoiseHash(cell + vec3(0,1,1)), lfAtmosphereNoiseHash(cell + vec3(1,1,1)), f.x), f.y), f.z);\n}\nvec3 lfAtmosphereDecodeDisplay(vec3 color) {\n    color = max(color, vec3(0.0));\n    return mix(color / 12.92, pow((color + 0.055) / 1.055, vec3(2.4)),\n        step(vec3(0.04045), color));\n}\nvec3 lfAtmosphereEncodeDisplay(vec3 color) {\n    color = max(color, vec3(0.0));\n    return mix(color * 12.92, 1.055 * pow(color, vec3(1.0 / 2.4)) - 0.055,\n        step(vec3(0.0031308), color));\n}\nfloat lfAtmosphereFogFactor(float distanceToCamera, float worldHeight) {\n    float mode = lfAtmosphereFogParams.x;\n    if (mode < 0.5) return 0.0;\n    float fogStart = lfAtmosphereFogParams.y;\n    float fogEnd = lfAtmosphereFogParams.z;\n    float density = max(lfAtmosphereFogParams.w, 0.0);\n    float maximumOpacity = clamp(lfAtmosphereHeightParams.z, 0.0, 1.0);\n    float distanceValue = max(distanceToCamera - fogStart, 0.0);\n    float factor = 0.0;\n    if (mode < 1.5) {\n        float linearFactor = lfAtmosphereDistanceRamp(distanceToCamera, fogStart, fogEnd, lfAtmosphereArtParams.x);\n        float smoothFactor = linearFactor * linearFactor * (3.0 - 2.0 * linearFactor);\n        factor = mix(linearFactor, smoothFactor, lfAtmosphereStyleParams.x);\n    } else if (mode < 2.5) {\n        factor = 1.0 - exp(-density * distanceValue);\n    } else if (mode < 3.5) {\n        float extinction = density * distanceValue;\n        factor = 1.0 - exp(-(extinction * extinction));\n    } else {\n        float falloff = max(lfAtmosphereHeightParams.y, 0.0);\n        float rayLength = max(distanceValue, 0.0);\n        float originDensity = density * exp(clamp(-falloff * (lfAtmosphereCameraHeight - lfAtmosphereHeightParams.x), -40.0, 40.0));\n        float directionY = (worldHeight - lfAtmosphereCameraHeight) / max(distanceToCamera, 0.0001);\n        float slope = falloff * directionY;\n        originDensity *= exp(clamp(-slope * fogStart, -40.0, 40.0));\n        float densityIntegral = abs(slope) < 0.00001\n            ? originDensity * rayLength\n            : originDensity * (1.0 - exp(clamp(-slope * rayLength, -40.0, 40.0))) / slope;\n        factor = 1.0 - exp(-max(densityIntegral, 0.0));\n    }\n    // Endpoint envelope protects the foreground and fully covered silhouettes.\n    float envelope = factor * (1.0 - factor) * 4.0;\n    if (lfAtmosphereArtParams.z > 0.0001) {\n        factor += (lfAtmosphereNoise(lfAtmosphereWorldPosition / lfAtmosphereArtParams.w) - 0.5)\n            * lfAtmosphereArtParams.z * envelope * 0.35;\n    }\n    if (lfAtmosphereStyleParams.y > 0.0001 && envelope > 0.0) {\n        vec2 framePixel = gl_FragCoord.xy * lfAtmosphereFrameParams.xy + lfAtmosphereFrameParams.zw;\n        float dither = (fract(52.9829189 * fract(dot(framePixel, vec2(0.06711056, 0.00583715)))) - 0.5) * envelope;\n        factor += dither * lfAtmosphereStyleParams.y / 255.0;\n    }\n    return min(clamp(factor, 0.0, 1.0), maximumOpacity);\n}\n#define SA_TEXTURE_ALPHA_OPAQUE 0\n#define SA_TEXTURE_ALPHA_TRANSLUCENT 0\nuniform float SA_ALPHA_CUTOFF;\n#define SA_NATIVE_PBR_HAS_MER_MAP 0\n#define SA_NATIVE_PBR_HAS_EMISSIVE_MAP 0\n#define SA_NATIVE_PBR_HAS_NORMAL_MAP 0\n#define SA_NATIVE_PBR_HAS_HEIGHT_MAP 0\n\nuniform bool AFFECTED_BY_LIGHT;\nuniform int uSAAlphaMode;\nuniform float uSAOpacity;\n\n                    \n#ifndef LIGHTFLOW_TEXTURE_TILING_MODULE\n#define LIGHTFLOW_TEXTURE_TILING_MODULE\n\nuniform bool AUTO_TILE;\nuniform vec2 TILING;\nuniform vec2 TEXTURE_SIZE;\n\nvec2 lfResolveTextureTiling(\n    vec2 faceSize,\n    vec2 uvSize,\n    float geometryAutoTile\n) {\n    if (geometryAutoTile > 0.5 || AUTO_TILE) {\n        vec2 safeFaceSize = max(abs(faceSize), vec2(0.000001));\n        vec2 tileSize = max(abs(uvSize * faceSize), vec2(0.000001));\n        return safeFaceSize / tileSize;\n    }\n\n    return TILING;\n}\n\n// Backward-compatible overload for custom shaders that still use the uniform.\nvec2 lfResolveTextureTiling(vec2 faceSize, vec2 uvSize) {\n    return lfResolveTextureTiling(faceSize, uvSize, AUTO_TILE ? 1.0 : 0.0);\n}\n\n#ifndef LIGHTFLOW_TEXTURE_TILING_VERTEX_STAGE\nbool lfResolveTextureDerivativeBasis(\n    vec2 derivativeDx,\n    vec2 derivativeDy,\n    out vec2 normalizedDx,\n    out vec2 normalizedDy,\n    out float derivativeScale,\n    out float inverseDeterminant\n) {\n    derivativeScale = max(\n        max(abs(derivativeDx.x), abs(derivativeDx.y)),\n        max(abs(derivativeDy.x), abs(derivativeDy.y))\n    );\n    normalizedDx = vec2(0.0);\n    normalizedDy = vec2(0.0);\n    inverseDeterminant = 0.0;\n\n    if (derivativeScale <= 1e-12) return false;\n\n    normalizedDx = derivativeDx / derivativeScale;\n    normalizedDy = derivativeDy / derivativeScale;\n\n    float determinant = normalizedDx.x * normalizedDy.y -\n        normalizedDx.y * normalizedDy.x;\n    float basisArea = length(normalizedDx) * length(normalizedDy);\n    float basisQuality = abs(determinant) / max(basisArea, 1e-12);\n\n    if (abs(determinant) <= 1e-12 || basisQuality <= 1e-5) return false;\n\n    inverseDeterminant = 1.0 / determinant;\n    return true;\n}\n\nmat2 lfGetLocalToAtlasJacobian(vec2 localUv, vec2 atlasUv, out bool valid) {\n    vec2 localDx = dFdx(localUv);\n    vec2 localDy = dFdy(localUv);\n    vec2 atlasDx = dFdx(atlasUv);\n    vec2 atlasDy = dFdy(atlasUv);\n    vec2 normalizedLocalDx;\n    vec2 normalizedLocalDy;\n    float derivativeScale;\n    float inverseDeterminant;\n\n    valid = lfResolveTextureDerivativeBasis(\n        localDx,\n        localDy,\n        normalizedLocalDx,\n        normalizedLocalDy,\n        derivativeScale,\n        inverseDeterminant\n    );\n\n    if (!valid) return mat2(0.0);\n\n    vec2 normalizedAtlasDx = atlasDx / derivativeScale;\n    vec2 normalizedAtlasDy = atlasDy / derivativeScale;\n    vec2 atlasPerLocalX = (\n        normalizedAtlasDx * normalizedLocalDy.y -\n        normalizedAtlasDy * normalizedLocalDx.y\n    ) * inverseDeterminant;\n    vec2 atlasPerLocalY = (\n        normalizedAtlasDy * normalizedLocalDx.x -\n        normalizedAtlasDx * normalizedLocalDy.x\n    ) * inverseDeterminant;\n\n    return mat2(atlasPerLocalX, atlasPerLocalY);\n}\n\nvec2 lfResolveMaterialUvWithJacobian(\n    vec2 atlasUv,\n    vec2 localUv,\n    mat2 localToAtlas,\n    vec2 faceSize,\n    vec2 uvSize,\n    float geometryAutoTile\n) {\n    vec2 repeatCount = lfResolveTextureTiling(faceSize, uvSize, geometryAutoTile);\n    vec2 tiledLocalUv = localUv;\n\n    if (abs(repeatCount.x - 1.0) > 0.000001) {\n        tiledLocalUv.x = fract(localUv.x * repeatCount.x);\n    }\n    if (abs(repeatCount.y - 1.0) > 0.000001) {\n        tiledLocalUv.y = fract(localUv.y * repeatCount.y);\n    }\n\n    return atlasUv + localToAtlas * (tiledLocalUv - localUv);\n}\n\nbool lfResolveExplicitAutoTileBasis(\n    vec4 packedBasis,\n    out mat2 localToAtlas\n) {\n    localToAtlas = mat2(packedBasis.xy, packedBasis.zw);\n    float determinant = packedBasis.x * packedBasis.w -\n        packedBasis.z * packedBasis.y;\n    float basisScale = max(\n        max(abs(packedBasis.x), abs(packedBasis.y)),\n        max(abs(packedBasis.z), abs(packedBasis.w))\n    );\n    return basisScale > 1e-12 && abs(determinant) > 1e-12;\n}\n\nbool lfResolveUv(\n    vec2 localUv,\n    vec2 atlasUv,\n    vec4 explicitAutoTileBasis,\n    out mat2 localToAtlas\n) {\n    if (lfResolveExplicitAutoTileBasis(explicitAutoTileBasis, localToAtlas)) {\n        return true;\n    }\n    bool validJacobian = false;\n    localToAtlas = lfGetLocalToAtlasJacobian(localUv, atlasUv, validJacobian);\n    return validJacobian;\n}\n\nvec2 lfResolveMaterialUv(\n    vec2 atlasUv,\n    vec2 localUv,\n    vec2 faceSize,\n    vec2 uvSize,\n    float geometryAutoTile,\n    vec4 explicitAutoTileBasis\n) {\n    mat2 localToAtlas;\n    if (!lfResolveUv(\n        localUv,\n        atlasUv,\n        explicitAutoTileBasis,\n        localToAtlas\n    )) return atlasUv;\n    return lfResolveMaterialUvWithJacobian(\n        atlasUv,\n        localUv,\n        localToAtlas,\n        faceSize,\n        uvSize,\n        geometryAutoTile\n    );\n}\n\nvec2 lfResolveMaterialUv(\n    vec2 atlasUv,\n    vec2 localUv,\n    vec2 faceSize,\n    vec2 uvSize,\n    float geometryAutoTile\n) {\n    return lfResolveMaterialUv(\n        atlasUv,\n        localUv,\n        faceSize,\n        uvSize,\n        geometryAutoTile,\n        vec4(0.0)\n    );\n}\n\nvec2 lfResolveMaterialUv(\n    vec2 atlasUv,\n    vec2 localUv,\n    vec2 faceSize,\n    vec2 uvSize\n) {\n    return lfResolveMaterialUv(\n        atlasUv,\n        localUv,\n        faceSize,\n        uvSize,\n        AUTO_TILE ? 1.0 : 0.0\n    );\n}\n#endif\n\n#endif\n\n\n                     uniform sampler2D map;\n                     uniform bool EMISSIVE;\n                     uniform vec3 LIGHTCOLOR;\n\n                     varying vec2 vUv;\n                    varying vec2 vNormalizedFaceUv;\n                    varying vec2 vFaceSize;\n                    varying vec2 vUvSize;\n                    varying float vAutoTile;\n                    varying vec4 vAutoTileBasis;\n                     varying float light;\n                     varying float lift;\n\n                     void main() {\n    vec3 saMRTDefaultNormal = normalize(vSA_MRTViewNormal);\n    if (!gl_FrontFacing) saMRTDefaultNormal *= -1.0;\n    saMRTSurface = vec4(saMRTDefaultNormal * 0.5 + 0.5, 0.5);\n    saMRTEmission = vec4(0.0);\n#if SA_LIGHTFLOW_MRT4_RIM_GLOW_ENABLED == 1\n    saMRTRimGlow = vec4(0.0);\n#endif\n#if SA_LIGHTFLOW_MRT5_RIM_DEPTH_ENABLED == 1\n    saMRTRimDepth = vec4(1.0);\n#endif\n                        vec2 materialUv =\n                            lfResolveMaterialUv(\n                                vUv,\n                                vNormalizedFaceUv,\n                                vFaceSize,\n                                vUvSize,\n                                vAutoTile,\n                                vAutoTileBasis\n                            );\n                        vec4 color = texture2D(map, materialUv);\n    float saUnlitSourceAlpha = color.a;\n    if (uSAAlphaMode == 1) color.a = 1.0;\n    color.a *= clamp(uSAOpacity, 0.0, 1.0);\n    // SA_UNLIT_TEXTURE_BRANCH\n    if (!AFFECTED_BY_LIGHT) {\n        if (color.a < SA_ALPHA_CUTOFF) {\n            discard;\n        }\n        vec3 saUnlitBaseLinear = pow(max(color.rgb, vec3(0.0)), vec3(2.2));\n        vec3 saUnlitEmission = max(vec3(0.0), vec3(0.0));\n        if (EMISSIVE) saUnlitEmission += saUnlitBaseLinear * (1.0 - clamp(saUnlitSourceAlpha, 0.0, 1.0));\n        vec3 saUnlitBloom = saUnlitEmission * color.a;\n#ifdef SA_RENDERCRAFT_RIM_GLOW\n        gl_FragColor = vec4(0.0);\n#elif defined(SA_RENDERCRAFT_GLOW_BLOOM) || defined(SA_RENDERCRAFT_STUDIO_BLOOM)\n        gl_FragColor = vec4(log2(vec3(1.0) + clamp(saUnlitBloom, vec3(0.0), vec3(16.0))) * 0.2446505421,\n            step(0.000001, max(saUnlitBloom.r, max(saUnlitBloom.g, saUnlitBloom.b))));\n#else\n        gl_FragColor = color;\n#endif\n        // SA_UNLIT_EMISSION_EXPORT\n    saMRTEmission = vec4(log2(vec3(1.0) + clamp(saUnlitEmission, vec3(0.0), vec3(16.0))) * 0.2446505421, 0.0);\n#if SA_TEXTURE_ALPHA_TRANSLUCENT == 1\n    saMRTEmission.a = gl_FragColor.a;\n#endif\n#if !defined(SA_RENDERCRAFT_RIM_GLOW) && !defined(SA_RENDERCRAFT_GLOW_BLOOM) && !defined(SA_RENDERCRAFT_STUDIO_BLOOM)\n        {\n    // Unlit atmosphere uses the same interpolated position. Interpolated vertex lengths\n    // change with triangulation and exaggerate fog on large merged terrain.\n    float lfDistance = length(lfAtmosphereViewPosition);\n    if (lfAtmosphereGradeParams.x > 0.5) {\n        float lfGradeWeight = smoothstep(lfAtmosphereGradeParams.y, lfAtmosphereGradeParams.z, lfDistance);\n        lfGradeWeight = pow(lfGradeWeight, lfAtmosphereGradeParams.w);\n        vec3 lfSource = gl_FragColor.rgb;\n        float lfLuma = dot(lfSource, vec3(0.2126, 0.7152, 0.0722));\n        vec3 lfGraded = mix(vec3(lfLuma), lfSource, lfAtmosphereGradeLook.x);\n        lfGraded = (lfGraded - lfAtmosphereGradeLook.w) * lfAtmosphereGradeLook.y + lfAtmosphereGradeLook.w;\n        float lfTintLuma = max(dot(lfAtmosphereGradeTint, vec3(0.2126, 0.7152, 0.0722)), 0.001);\n        vec3 lfTinted = lfGraded * lfAtmosphereGradeTint / lfTintLuma;\n        lfGraded = mix(lfGraded, lfTinted, lfAtmosphereGradeLook.z);\n        gl_FragColor.rgb = mix(lfSource, max(lfGraded, vec3(0.0)), lfGradeWeight);\n    }\n    float lfFogFactor = lfAtmosphereFogFactor(lfDistance, lfAtmosphereWorldHeight);\n    float lfFogProgress = lfAtmosphereDistanceRamp(lfDistance, lfAtmosphereFogParams.y, lfAtmosphereFogParams.z, lfAtmosphereArtParams.x);\n    vec3 lfFogColor = lfAtmosphereFogColor;\n    if (lfAtmosphereStyleParams.z > 0.0001) {\n        // Keep the authored transition shape, independently of the opacity cap\n        // and texture. Neutral settings retain the previous color ramp.\n        float lfFogRampFactor = mix(lfFogProgress, lfFogProgress * lfFogProgress * (3.0 - 2.0 * lfFogProgress), lfAtmosphereStyleParams.x);\n        float lfFogGradient = pow(lfFogRampFactor, 0.72);\n        vec3 lfFogRampColor = mix(lfAtmosphereFogNearColor, lfAtmosphereFogColor, lfFogGradient);\n        lfFogColor = mix(lfAtmosphereFogColor, lfFogRampColor, lfAtmosphereStyleParams.z);\n    }\n    if (lfAtmosphereArtParams.y > 0.0001 && lfFogFactor > 0.0) {\n        float up = clamp((lfAtmosphereWorldHeight - lfAtmosphereCameraHeight) / max(lfDistance, 0.0001), -1.0, 1.0);\n        float skyPosition = 0.5 + sign(up) * 0.5 * pow(abs(up), lfAtmosphereSkyParams.y);\n        vec3 skyColor = texture2D(lfAtmosphereSkyGradient, vec2(skyPosition, 0.5)).rgb * lfAtmosphereSkyParams.x;\n        lfFogColor = mix(lfFogColor, skyColor, lfAtmosphereArtParams.y * smoothstep(0.0, 1.0, lfFogProgress));\n    }\n    // Beauty and authored fog colors are display encoded here. Mix light in\n    // display-linear space to avoid dark seams around bright silhouettes.\n    // The zero-fog path stays exact and does not pay for transfer functions.\n    if (lfFogFactor > 0.0) {\n        gl_FragColor.rgb = lfAtmosphereEncodeDisplay(mix(\n            lfAtmosphereDecodeDisplay(gl_FragColor.rgb),\n            lfAtmosphereDecodeDisplay(lfFogColor),\n            lfFogFactor\n        ));\n    }\n}\n#endif\n        return;\n    }\n\n                         if(color.a < SA_ALPHA_CUTOFF) discard;\n\n                        if (!EMISSIVE) {\n                            gl_FragColor = vec4(lift + color.rgb * light, color.a);\n                            gl_FragColor.rgb *= LIGHTCOLOR;\n                        } else {\n                            vec3 light_mix = (light * LIGHTCOLOR) + (1.0 - light * LIGHTCOLOR) * (1.0 - color.a);\n                            gl_FragColor = vec4(lift + color.rgb * light_mix, 1.0);\n                        }\n\n                        if (lift > 0.2) {\n                            gl_FragColor.rg *= vec2(0.6, 0.7);\n                        }\n                    \n    // Interpolate position, then measure distance. Interpolated vertex lengths\n    // change with triangulation and exaggerate fog on large merged terrain.\n    float lfDistance = length(lfAtmosphereViewPosition);\n    if (lfAtmosphereGradeParams.x > 0.5) {\n        float lfGradeWeight = smoothstep(lfAtmosphereGradeParams.y, lfAtmosphereGradeParams.z, lfDistance);\n        lfGradeWeight = pow(lfGradeWeight, lfAtmosphereGradeParams.w);\n        vec3 lfSource = gl_FragColor.rgb;\n        float lfLuma = dot(lfSource, vec3(0.2126, 0.7152, 0.0722));\n        vec3 lfGraded = mix(vec3(lfLuma), lfSource, lfAtmosphereGradeLook.x);\n        lfGraded = (lfGraded - lfAtmosphereGradeLook.w) * lfAtmosphereGradeLook.y + lfAtmosphereGradeLook.w;\n        float lfTintLuma = max(dot(lfAtmosphereGradeTint, vec3(0.2126, 0.7152, 0.0722)), 0.001);\n        vec3 lfTinted = lfGraded * lfAtmosphereGradeTint / lfTintLuma;\n        lfGraded = mix(lfGraded, lfTinted, lfAtmosphereGradeLook.z);\n        gl_FragColor.rgb = mix(lfSource, max(lfGraded, vec3(0.0)), lfGradeWeight);\n    }\n    float lfFogFactor = lfAtmosphereFogFactor(lfDistance, lfAtmosphereWorldHeight);\n    float lfFogProgress = lfAtmosphereDistanceRamp(lfDistance, lfAtmosphereFogParams.y, lfAtmosphereFogParams.z, lfAtmosphereArtParams.x);\n    vec3 lfFogColor = lfAtmosphereFogColor;\n    if (lfAtmosphereStyleParams.z > 0.0001) {\n        // Keep the authored transition shape, independently of the opacity cap\n        // and texture. Neutral settings retain the previous color ramp.\n        float lfFogRampFactor = mix(lfFogProgress, lfFogProgress * lfFogProgress * (3.0 - 2.0 * lfFogProgress), lfAtmosphereStyleParams.x);\n        float lfFogGradient = pow(lfFogRampFactor, 0.72);\n        vec3 lfFogRampColor = mix(lfAtmosphereFogNearColor, lfAtmosphereFogColor, lfFogGradient);\n        lfFogColor = mix(lfAtmosphereFogColor, lfFogRampColor, lfAtmosphereStyleParams.z);\n    }\n    if (lfAtmosphereArtParams.y > 0.0001 && lfFogFactor > 0.0) {\n        float up = clamp((lfAtmosphereWorldHeight - lfAtmosphereCameraHeight) / max(lfDistance, 0.0001), -1.0, 1.0);\n        float skyPosition = 0.5 + sign(up) * 0.5 * pow(abs(up), lfAtmosphereSkyParams.y);\n        vec3 skyColor = texture2D(lfAtmosphereSkyGradient, vec2(skyPosition, 0.5)).rgb * lfAtmosphereSkyParams.x;\n        lfFogColor = mix(lfFogColor, skyColor, lfAtmosphereArtParams.y * smoothstep(0.0, 1.0, lfFogProgress));\n    }\n    // Beauty and authored fog colors are display encoded here. Mix light in\n    // display-linear space to avoid dark seams around bright silhouettes.\n    // The zero-fog path stays exact and does not pay for transfer functions.\n    if (lfFogFactor > 0.0) {\n        gl_FragColor.rgb = lfAtmosphereEncodeDisplay(mix(\n            lfAtmosphereDecodeDisplay(gl_FragColor.rgb),\n            lfAtmosphereDecodeDisplay(lfFogColor),\n            lfFogFactor\n        ));\n    }\n}\n                 ","extensions":{"derivatives":true}},"saRenderBatchSuppressedMaterialIndices":null,"saRenderBatchCastShadow":true,"saRenderBatchReceiveShadow":false}},{"translatio